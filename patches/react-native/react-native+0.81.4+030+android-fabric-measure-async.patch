+void UIManagerBinding::reportMeasureAsyncOnUI(
+    int callbackId,
+    double x,
+    double y,
+    double width,
+    double height,
+    double pageX,
+    double pageY) {
+  auto callback = consumeMeasureCallback(callbackId);
+  if (auto wrapper = callback.lock()) {
+    wrapper->jsInvoker().invokeAsync(
+        [callback,
+         x,
+         y,
+         width,
+         height,
+         pageX,
+         pageY](jsi::Runtime& runtime) {
+          if (auto innerWrapper = callback.lock()) {
+            innerWrapper->callback().call(
+                runtime,
+                jsi::Value(x),
+                jsi::Value(y),
+                jsi::Value(width),
+                jsi::Value(height),
+                jsi::Value(pageX),
+                jsi::Value(pageY));
+            innerWrapper->destroy();
+          }
+        });
+  }
+}
