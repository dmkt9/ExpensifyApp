+int UIManagerBinding::registerMeasureCallback(
+    jsi::Runtime& runtime,
+    jsi::Function&& callback) {
+  auto runtimeScheduler = RuntimeSchedulerBinding::getBinding(runtime);
+  react_native_assert(runtimeScheduler != nullptr);
+
+  auto wrapper = CallbackWrapper::createWeak(
+      std::move(callback),
+      runtime,
+      std::make_shared<RuntimeSchedulerCallInvoker>(
+          runtimeScheduler->getRuntimeScheduler()));
+
+  std::lock_guard lock(measureCallbacksMutex_);
+  auto callbackId = ++nextMeasureCallbackId_;
+  measureCallbacks_[callbackId] = wrapper;
+  return callbackId;
+}
+
+std::weak_ptr<CallbackWrapper> UIManagerBinding::consumeMeasureCallback(
+    int callbackId) {
+  std::lock_guard lock(measureCallbacksMutex_);
+  auto iterator = measureCallbacks_.find(callbackId);
+  if (iterator == measureCallbacks_.end()) {
+    return {};
+  }
+
+  auto callback = iterator->second;
+  measureCallbacks_.erase(iterator);
+  return callback;
+}
