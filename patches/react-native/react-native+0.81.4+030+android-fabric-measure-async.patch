+void FabricUIManagerBinding::reportMeasureAsyncOnUI(
+    jint callbackId,
+    jdouble x,
+    jdouble y,
+    jdouble width,
+    jdouble height,
+    jdouble pageX,
+    jdouble pageY) {
+  auto scheduler = getScheduler();
+  if (!scheduler) {
+    LOG(ERROR)
+        << "FabricUIManagerBinding::reportMeasureAsyncOnUI: scheduler disappeared";
+    return;
+  }
+
+  auto runtimeScheduler =
+      scheduler->getContextContainer()->find<std::weak_ptr<RuntimeScheduler>>(
+          RuntimeSchedulerKey);
+  if (!runtimeScheduler.has_value()) {
+    LOG(ERROR)
+        << "FabricUIManagerBinding::reportMeasureAsyncOnUI: runtime scheduler missing";
+    return;
+  }
+
+  if (auto strongRuntimeScheduler = runtimeScheduler.value().lock()) {
+    strongRuntimeScheduler->scheduleWork(
+        [callbackId, x, y, width, height, pageX, pageY](jsi::Runtime& runtime) {
+          auto binding = UIManagerBinding::getBinding(runtime);
+          if (binding != nullptr) {
+            binding->reportMeasureAsyncOnUI(
+                callbackId, x, y, width, height, pageX, pageY);
+          }
+        });
+  }
+}
