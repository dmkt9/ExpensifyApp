+
+package com.facebook.react.fabric.mounting
+
+import android.graphics.Matrix
+import android.graphics.RectF
+import android.view.View
+import android.view.ViewParent
+
+internal object MeasureAsyncUtil {
+    private fun mapRectFromViewToRootCoords(view: View, rootView: View, rect: RectF) {
+        var currentView: View = view
+        var currentParent: ViewParent? = view.parent
+
+        val matrix = currentView.matrix
+        if (!matrix.isIdentity) {
+            matrix.mapRect(rect)
+        }
+        rect.offset(currentView.left.toFloat(), currentView.top.toFloat())
+
+        while (currentParent is View && currentParent !== rootView) {
+            val parentView = currentParent
+            rect.offset(-parentView.scrollX.toFloat(), -parentView.scrollY.toFloat())
+
+            val parentMatrix: Matrix = parentView.matrix
+            if (!parentMatrix.isIdentity) {
+                parentMatrix.mapRect(rect)
+            }
+
+            rect.offset(parentView.left.toFloat(), parentView.top.toFloat())
+            currentView = parentView
+            currentParent = currentView.parent
+        }
+    }
+
+    fun measureRelativeToRoot(view: View, rootView: View): DoubleArray {
+        val boundingBox = RectF(0f, 0f, view.width.toFloat(), view.height.toFloat())
+        mapRectFromViewToRootCoords(view, rootView, boundingBox)
+
+        val x = boundingBox.left.toDouble()
+        val y = boundingBox.top.toDouble()
+        val width = (boundingBox.right - boundingBox.left).toDouble()
+        val height = (boundingBox.bottom - boundingBox.top).toDouble()
+
+        return doubleArrayOf(0.0, 0.0, width, height, x, y)
+    }
+}
